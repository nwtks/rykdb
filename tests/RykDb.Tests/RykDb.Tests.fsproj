<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="ErrorsTests.fs" />
    <Compile Include="TypesTests.fs" />
    <Compile Include="SerializationTests.fs" />
    <Compile Include="MemtableTests.fs" />
    <Compile Include="WalTests.fs" />
    <Compile Include="BloomFilterTests.fs" />
    <Compile Include="SstableTests.fs" />
    <Compile Include="VersionSetTests.fs" />
    <Compile Include="ManifestTests.fs" />
    <Compile Include="CompactionTests.fs" />
    <Compile Include="StorageEngineTests.fs" />
    <Compile Include="TransactionsTests.fs" />
    <Compile Include="AstTests.fs" />
    <Compile Include="LexerTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="RowStoreTests.fs" />
    <Compile Include="CatalogTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="EvalTests.fs" />
    <Compile Include="OpsTests.fs" />
    <Compile Include="ExecContextTests.fs" />
    <Compile Include="PlannerTests.fs" />
    <Compile Include="EngineTests.fs" />
    <Compile Include="DatabaseTests.fs" />
    <Compile Include="ServerTests.fs" />
    <Compile Include="TestHealthTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit.v3" Version="3.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*" />
    <PackageReference Include="coverlet.msbuild" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RykDb.Core\RykDb.Core.fsproj" />
    <ProjectReference Include="..\..\src\RykDb.Server\RykDb.Server.fsproj" />
  </ItemGroup>

</Project>
